; Digital Fighters - prototipo de luta 2D para PC
config_version=5

[application]
config/name="Digital Fighters"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0

[input]
p1_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":65)]}
p1_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":68)]}
p1_jump={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":87)]}
p1_crouch={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":83)]}
p1_light={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":70)]}
p1_heavy={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":71)]}
p1_special={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":72)]}
p1_block={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":82)]}
p2_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194311)]}
p2_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194313)]}
p2_jump={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194320)]}
p2_crouch={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194322)]}
p2_light={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":74)]}
p2_heavy={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":75)]}
p2_special={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":76)]}
p2_block={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":73)]}

[layer_names]
2d_physics/layer_1="Fighters"
